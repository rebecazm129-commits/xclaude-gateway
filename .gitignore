node_modules/
dist/
out/
build/
# El build/ raíz no es output: contiene los recursos de packaging
# (entitlements, iconos) que electron-builder.yml y el README referencian.
!/build/
release/
*.tsbuildinfo
*.dmg
*.zip
.DS_Store
.vscode/
.idea/
*.log
.env
.env.local
.env.*.local
coverage/
.claude/settings.local.json

# Modelo NER materializado por `pnpm fetch:model` (cuestion a / packaging).
# Artefacto binario (~105MB q8 + configs), fuera de git por decision de
# producto: el .app lo empaqueta via electron-builder extraResources.
packages/proxy/models/

# Disposable empirical spikes — never committed.
spike/

# Local manual backups (e.g. apps/desktop/dist_0.6.0_manual.bak/).
*.bak/

# Corpus negatives derived from the operator's own trail: real vendor tool
# names, descriptions and schemas tied to one installation. The mechanism that
# loads them is in packages/proxy/tests/corpus; the data never enters the repo.
corpus-local/

# Visual-regression snapshots: megabytes of machine-specific pixels. A
# baseline committed from one display would fail on every other.
apps/desktop/.visual/
