    "severity": {
      "minimum": "high"
    },
    "status": "gap",
    "split": "dev",
    "notes": "Probe 24/09: injectionFindings runs only inside the changed-description branch of an EXISTING tool (manifest.ts:235), so a new tool's description is never scanned. Emits tool_added/low today - the lowest grade for the least constrained case."
