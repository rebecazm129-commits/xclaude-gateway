[
  {
    "id": "prose-rewrite-description",
    "title": "A vendor rewrites a tool description with no change of meaning",
    "provenance": {
      "source": "synthetic",
      "url": null,
      "licence": "CC0-1.0"
    },
    "technique": "doc_edit",
    "observable": "manifest",
    "baseline": {
      "tools": [
        {
          "name": "send",
          "description": "Send a message to the channel.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "body": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "changed": {
      "tools": [
        {
          "name": "send",
          "description": "Post a message into the selected channel.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "body": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "malicious": false,
    "expected_changes": [
      "description_changed"
    ],
    "expected_findings": [],
    "severity": {
      "maximum": "medium"
    },
    "status": "covered",
    "split": "dev",
    "notes": "The single most common real change: 258 description_changed findings in four months of production traffic."
  },
